NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Replace user/password/database; URL-encode special characters in credentials.
DATABASE_URL=postgresql://moneymate:CHANGE_ME@127.0.0.1:5432/moneymate
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000

ACCESS_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d
SALT_ROUNDS=10
