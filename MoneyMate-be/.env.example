NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://moneymate:CHANGE_ME@127.0.0.1:5432/moneymate
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
# Required: create a random secret of at least 32 characters. Never commit it.
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000/api/auth
# SERVER_URL=http://localhost:3000/api
# FRONTEND_BASE_URL=http://localhost:8081

# Telegram optional; token stays local, never commit real values.
# TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling
AI_SERVICE_URL=http://127.0.0.1:3001
# AI_SERVICE_TOKEN=
# TELEGRAM_PUBLIC_URL=https://api.example.com
# TELEGRAM_WEBHOOK_SECRET=
