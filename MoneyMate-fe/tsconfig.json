{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/configs": ["./src/configs"],
      "@/configs/*": ["./src/configs/*"],
      "@/assets": ["./assets"],
      "@/assets/*": ["./assets/*"],
      "@/components": ["./src/components"],
      "@/components/*": ["./src/components/*"],
      "@/atoms": ["./src/components/atoms"],
      "@/atoms/*": ["./src/components/atoms/*"],
      "@/molecules": ["./src/components/molecules"],
      "@/molecules/*": ["./src/components/molecules/*"],
      "@/organisms": ["./src/components/organisms"],
      "@/organisms/*": ["./src/components/organisms/*"],
      "@/templates": ["./src/components/templates"],
      "@/templates/*": ["./src/components/templates/*"],
      "@/screens": ["./src/screens"],
      "@/screens/*": ["./src/screens/*"],
      "@/pages": ["./src/screens"],
      "@/pages/*": ["./src/screens/*"],
      "@/routes": ["./src/routes"],
      "@/routes/*": ["./src/routes/*"],
      "@/types": ["./src/types"],
      "@/types/*": ["./src/types/*"],
      "@/constants": ["./src/constants"],
      "@/constants/*": ["./src/constants/*"],
      "@/hooks": ["./src/hooks"],
      "@/hooks/*": ["./src/hooks/*"],
      "@/providers": ["./src/providers"],
      "@/providers/*": ["./src/providers/*"],
      "@/helpers": ["./src/helpers"],
      "@/helpers/*": ["./src/helpers/*"],
      "@/schemas": ["./src/schemas"],
      "@/schemas/*": ["./src/schemas/*"],
      "@/services": ["./src/services"],
      "@/services/*": ["./src/services/*"],
      "@/theme": ["./src/theme"],
      "@/theme/*": ["./src/theme/*"]
    },
    "allowImportingTsExtensions": true,
    "types": ["react", "node"]
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
